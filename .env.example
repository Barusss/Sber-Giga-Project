# Copy this file to .env and put your actual key there.
# .env is ignored by git. NEVER commit the real API key.
DATABASE_URL=postgresql+psycopg://sber:sber@db:5432/sber
DATABASE_URL_TEST=sqlite+pysqlite:///:memory:
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
VITE_API_URL=http://localhost:8000/api/v1

# DeepSeek: used only by the FastAPI backend, never by Vite / browser.
# Create a key at https://platform.deepseek.com/api_keys and paste it after "=".
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Default disabled for structured JSON extraction, avoids tool_choice conflicts.
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=3000

# Optional local semantic search for TU/ZnP matching.
# 384-мерная модель; без неё — лексический режим.
# Docker image installs fastembed; local venv may need:
# pip install "fastembed>=0.4,<1"
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32

# Optional PP-OCRv5 mobile detection + East Slavic recognition (CPU).
INSTALL_PADDLE_OCR=false
OCR_BACKEND=tesseract
OCR_DPI=200
OCR_TIMEOUT_SECONDS=60
MAX_PDF_PAGES=500
# Optional directories for pre-downloaded official Paddle models:
# PADDLE_DETECTION_MODEL_DIR=/models/PP-OCRv5_mobile_det_infer
# PADDLE_RECOGNITION_MODEL_DIR=/models/eslav_PP-OCRv5_mobile_rec_infer
